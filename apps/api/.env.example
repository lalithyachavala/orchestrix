# Orchestrix API — all optional. Platform runs fully with none of these set.

# Agent reasoning adapter. Default: mock (deterministic, keyless).
# Set to "claude" or "openai" ONLY if you add the matching adapter + key.
ADAPTER=mock

# Opt-in real LLM keys. Leave blank to stay keyless. Never commit real keys.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# CORS origin for the web app.
WEB_ORIGIN=http://localhost:3000
